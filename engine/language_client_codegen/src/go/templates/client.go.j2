var bamlRuntime *baml.BamlRuntime

func init() {
	var env_vars = map[string]string{}
	for _, env_var := range os.Environ() {
		key, value, _ := strings.Cut(env_var, "=")
		env_vars[key] = value
	}
	baml.SetTypeMap(typeMap, streamTypeMap)
	runtime, err := baml.CreateRuntime("./baml_src", getBamlFiles(), env_vars)
	if err != nil {
		panic(err)
	}
	bamlRuntime = &runtime
}

type stream struct {}

var Stream = &stream{}

func castOptional[T any](result any, castResult func(any) T) *T {
	if result == nil {
		return nil
	}
	val := castResult(result)
	return &val
}

type StreamValue[T any, U any] struct {
	IsFinal bool
	as_final *T
	as_stream *U
}

func (s *StreamValue[T, U]) Final() T {
	return *s.as_final
}

func (s *StreamValue[T, U]) Stream() U {
	return *s.as_stream
}

