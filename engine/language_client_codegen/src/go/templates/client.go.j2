func (*stream) {{ fn.name }}(ctx context.Context{% for (name, type) in fn.args -%}
		, {{name}} {{type}}
		{%- endfor %}) <-chan StreamValue[{{ fn.return_type }}, {{ fn.partial_return_type }}] {
	args := baml.BamlFunctionArguments{
		Kwargs: map[string]any{ {% for (name, type) in fn.args -%}"{{name}}": {{name}},{% endfor %} },
	}
	encoded, err := baml.EncodeRoot(args)
	if err != nil {
		panic(err)
	}
	channel := make(chan StreamValue[{{ fn.return_type }}, {{ fn.partial_return_type }}])
	raw, err := bamlRuntime.CallFunctionStream(ctx, "{{ fn.name }}", encoded)
	if err != nil {
		close(channel)
		return channel
	}
	go func() {
		for {
			select {
			case <-ctx.Done():
				close(channel)
				return
			case result, ok := <-raw:
				if !ok {
					close(channel)
					return
				}
				if result.Error != nil {
					close(channel)
					return
				}
				if result.HasData {
					data := (*result.Data).({{ fn.return_type }})
					channel <- StreamValue[{{ fn.return_type }}, {{ fn.partial_return_type }}]{
						IsFinal: true,
						as_final: &data,
					}
				} else {
					data := (*result.StreamData).({{ fn.partial_return_type }})
					channel <- StreamValue[{{ fn.return_type }}, {{ fn.partial_return_type }}]{
						IsFinal: false,
						as_final: nil,
						as_stream: &data,
					}
				}
			}
		}
	}()
	return channel
}

